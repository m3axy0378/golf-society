# Copy this file to .env and fill in your own values before running locally.

# Postgres connection string. Locally this can point at a Postgres you run
# yourself; in production Vercel sets this automatically once you connect a
# database in the project's Storage tab (see README.md).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/golf_society

# Any long random string — used to sign login session cookies. Change this to
# something unique; don't reuse the example value.
SESSION_SECRET=please-change-this-to-something-random-and-long

# Port the app listens on locally (Vercel ignores this — it's serverless).
PORT=3000

# API key for the "UK Golf Course Data API" on RapidAPI, used by the "add a
# course" admin page to search real UK clubs/courses instead of typing every
# hole in by hand. Optional — without it, that search box just shows an
# "unavailable" message and the rest of the form (including the built-in
# quick-pick courses) still works normally.
# https://rapidapi.com/raznut303/api/uk-golf-course-data-api
RAPIDAPI_KEY=

# VAPID key pair for Web Push notifications (new competition alerts, and the
# admin "Notify players" button). Optional — without these set, push just
# quietly does nothing (no "Enable notifications" option is shown, and admin
# notify buttons no-op) rather than breaking anything else.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services if something's wrong with your notifications
# (e.g. it's spamming, or a key needs rotating) — any mailto: address or your
# site's https:// URL works.
VAPID_SUBJECT=mailto:admin@example.com

# Resend (https://resend.com) API key, used to send "forgot password" reset
# emails. Optional — without both of these set, the "Forgot your password?"
# link still works but silently sends no email (an admin can still reset a
# player's password manually from Admin → Players in the meantime).
# Free tier is 3,000 emails/month, no card required, but to send to real
# player inboxes (not just your own Resend account email) you need to verify
# a domain you own under Resend → Domains — a *.vercel.app domain can't be
# verified since you don't control its DNS, so this needs the society to have
# its own domain.
RESEND_API_KEY=
# Must be an address on the domain you verified above, e.g.
# "Tee League <no-reply@yourdomain.com>".
RESEND_FROM_EMAIL=

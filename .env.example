# Copy this file to .env and fill in your own values before running locally.

# Postgres connection string. Locally this can point at a Postgres you run
# yourself; in production Vercel sets this automatically once you connect a
# database in the project's Storage tab (see README.md).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/golf_society

# Any long random string — used to sign login session cookies. Change this to
# something unique; don't reuse the example value.
SESSION_SECRET=please-change-this-to-something-random-and-long

# Port the app listens on locally (Vercel ignores this — it's serverless).
PORT=3000

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' · ' + societyName : societyName %></title>
  <link rel="icon" type="image/svg+xml" href="/img/tee-league-favicon.svg">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#071a2b">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Tee League">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <script defer src="https://cdn.vercel-insights.com/v1/script.js"></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/dashboard">
      <img class="brand-icon" src="/img/tee-league-icon-gold.svg" alt="" width="28" height="28">
      <span class="brand-text">
        <span class="logo-wordmark">Tee <span class="accent">League</span></span>
        <span class="society-name"><%= societyName %></span>
      </span>
    </a>
    <% if (currentPlayer) { %>
      <nav class="topnav">
        <a href="/dashboard">Competitions</a>
        <a href="/season">Season</a>
        <a href="/handicaps">Handicaps</a>
        <a href="/profile">My Profile</a>
        <% if (currentPlayer.is_admin) { %>
          <a href="/admin/players">Admin</a>
        <% } %>
        <form method="POST" action="/logout" class="inline-form">
          <button type="submit" class="link-button">Log out</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main class="container">

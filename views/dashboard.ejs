<%- include('partials/header', { title: 'Competitions' }) %>

<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
  <h1 class="mt-0">Competitions</h1>
  <% if (currentPlayer.is_admin) { %>
    <a class="btn" href="/admin/competitions/new">+ New competition</a>
  <% } %>
</div>

<% if (competitions.length === 0) { %>
  <div class="card">
    <p>No competitions yet.</p>
    <% if (currentPlayer.is_admin) { %>
      <p class="muted">Start by <a href="/admin/courses/new">adding a course</a>, then create your first competition.</p>
    <% } %>
  </div>
<% } %>

<ul class="list-plain">
  <% competitions.forEach(c => { %>
    <li>
      <div>
        <a href="/competitions/<%= c.id %>"><strong><%= c.name %></strong></a>
        <div class="muted" style="font-size:0.85rem;">
          <%= new Date(c.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
          · <%= c.course_name %> · <%= FORMAT_LABELS[c.format] %>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;">
        <span class="badge <%= c.status === 'closed' ? 'closed' : '' %>"><%= c.status === 'open' ? 'Open' : 'Closed' %></span>
        <% if (myRoundCompIds.has(c.id)) { %><span class="badge">✓ Entered</span><% } %>
        <a class="btn btn-secondary" href="/competitions/<%= c.id %>">View</a>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Forgot password', mainClass: 'scoreboard-view' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <img class="brand-mark" src="/img/tee-league-icon-gold.svg" alt="" width="40" height="40">
    <h1>Forgot password</h1>
    <% if (sent) { %>
      <div class="success-box">If that email has an account, we've sent a link to reset the password — check your inbox (and spam folder).</div>
      <p class="auth-foot"><a class="sb-link" href="/login">Back to log in</a></p>
    <% } else { %>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <p class="muted" style="font-size:0.9rem;margin-top:-0.5rem;">Enter the email you log in with and we'll send you a link to set a new password.</p>
      <form class="stacked" method="POST" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Email
          <input type="email" name="email" required autofocus>
        </label>
        <button type="submit">Send reset link</button>
      </form>
      <p class="auth-foot"><a class="sb-link" href="/login">Back to log in</a></p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

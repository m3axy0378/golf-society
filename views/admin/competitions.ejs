<%- include('../partials/header', { title: 'Admin · Competitions', mainClass: 'scoreboard-view' }) %>

<nav class="admin-tabs">
  <a class="admin-tab" href="/admin/players">Players</a>
  <a class="admin-tab" href="/admin/courses">Courses</a>
  <a class="admin-tab active" href="/admin/competitions">Competitions</a>
  <a class="admin-tab" href="/admin/data">Data</a>
</nav>

<div class="admin-header-row">
  <h1 class="mt-0">Competitions</h1>
  <a class="btn" href="/admin/competitions/new">+ New competition</a>
</div>

<div class="card">
  <% if (competitions.length === 0) { %>
    <p class="muted">No competitions yet.</p>
  <% } else { %>
    <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.85rem;margin-bottom:0.75rem;">
      <input type="checkbox" id="selectAllComps"> Select all
    </label>
    <ul class="list-plain">
      <% competitions.forEach(c => { %>
        <li style="flex-direction:column;align-items:stretch;gap:0.6rem;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.5rem;">
            <div style="display:flex;align-items:flex-start;gap:0.5rem;">
              <input type="checkbox" class="comp-checkbox" value="<%= c.id %>" style="margin-top:0.3rem;">
              <div>
                <a href="/competitions/<%= c.id %>"><strong><%= c.name %></strong></a>
                <% if (c.type !== 'league') { %><span class="badge"><%= TYPE_LABELS[c.type] %></span><% } %>
                <div class="muted" style="font-size:0.85rem;margin-top:0.15rem;">
                  <%= new Date(c.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                  · <%= c.course_names %> · <%= FORMAT_LABELS[c.format] %> · <%= c.rounds_count %> entered
                </div>
              </div>
            </div>
            <span class="badge <%= c.status === 'closed' ? 'closed' : '' %>"><%= c.status === 'open' ? 'Open' : 'Closed' %></span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
            <% if (pairingSheetEnabled) { %><a class="btn btn-secondary" style="padding:0.25rem 0.6rem;" href="/admin/competitions/<%= c.id %>/pairings">Pairings</a><% } %>
            <form class="inline-form" method="POST" action="/admin/competitions/<%= c.id %>/notify"
              onsubmit="return confirm('Send a push notification about &quot;<%= c.name %>&quot; to every player who has notifications enabled?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;">Notify players</button>
            </form>
            <a class="btn btn-secondary" style="padding:0.25rem 0.6rem;" target="_blank" rel="noopener"
              href="https://wa.me/?text=<%- encodeURIComponent(`🏌️ New competition: ${c.name}\nCloses ${new Date(c.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}\n${baseUrl}/competitions/${c.id}`) %>">
              WhatsApp
            </a>
            <form class="inline-form" method="POST" action="/admin/competitions/<%= c.id %>/toggle-status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;"><%= c.status === 'open' ? 'End competition' : 'Reopen' %></button>
            </form>
            <form class="inline-form" method="POST" action="/admin/competitions/<%= c.id %>/delete"
              onsubmit="return confirm('Delete &quot;<%= c.name %>&quot; and every score submitted for it? This can\'t be undone.');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn-danger" style="padding:0.25rem 0.6rem;">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>

    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--sb-border);">
      <span class="muted" style="font-size:0.85rem;align-self:center;">With selected:</span>
      <button type="button" class="btn-secondary" id="clearSelectedBtn">Clear scores</button>
      <button type="button" class="btn-danger" id="deleteSelectedBtn">Delete</button>
    </div>
  <% } %>
</div>

<script>
  document.getElementById('selectAllComps').addEventListener('change', (e) => {
    document.querySelectorAll('.comp-checkbox').forEach((cb) => { cb.checked = e.target.checked; });
  });

  function selectedIds() {
    return Array.from(document.querySelectorAll('.comp-checkbox:checked')).map((cb) => parseInt(cb.value, 10));
  }

  async function bulkAction(url, verb) {
    const ids = selectedIds();
    if (ids.length === 0) { alert('Select at least one competition first.'); return; }
    if (!confirm(`${verb} ${ids.length} competition${ids.length === 1 ? '' : 's'}? This can't be undone.`)) return;

    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids }),
    });
    if (res.ok) {
      window.location.reload();
    } else {
      alert('Something went wrong — please try again.');
    }
  }

  const clearBtn = document.getElementById('clearSelectedBtn');
  const deleteBtn = document.getElementById('deleteSelectedBtn');
  if (clearBtn) {
    clearBtn.addEventListener('click', () => bulkAction('/admin/competitions/bulk-clear-scores', 'Clear all scores and entries for'));
  }
  if (deleteBtn) {
    deleteBtn.addEventListener('click', () => bulkAction('/admin/competitions/bulk-delete', 'Permanently delete'));
  }
</script>

<%- include('../partials/footer') %>

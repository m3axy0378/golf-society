<%- include('../partials/header', { title: 'Edit round', mainClass: 'scoreboard-view' }) %>

<h1 style="margin:0.75rem 20px 0;">Edit <%= round.player_name %>'s round</h1>
<p class="muted" style="margin:0 20px;">
  <%= round.comp_name %> · <%= round.course_name %> (<%= round.tee_name %> tees, par <%= round.course_par %>,
  CR <%= round.course_rating.toFixed(1) %> / SR <%= round.slope_rating %>)
</p>

<% if (error) { %><div class="error-box" style="margin:0.75rem 20px;"><%= error %></div><% } %>
<% if (typeof message !== 'undefined' && message) { %><div class="success-box" style="margin:0.75rem 20px;"><%= message %></div><% } %>

<div class="card" style="max-width:640px;">
  <h2 class="mt-0" style="font-size:1.05rem;">Wrong player or course?</h2>
  <p class="muted" style="font-size:0.85rem;">
    Moves this round — same hole-by-hole strokes, recalculated against the new player's or course's numbers.
    Both players' Handicap Index get recalculated afterward.
  </p>
  <div class="grid-2">
    <form class="inline-form" method="POST" action="/admin/rounds/<%= round.id %>/reassign-player"
      onsubmit="return confirm('Move this round to a different player?');" style="display:flex;gap:0.4rem;align-items:center;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <select name="playerId" required style="flex:1;min-width:0;">
        <% allPlayers.forEach(p => { %>
          <option value="<%= p.id %>" <%= p.id === round.player_id ? 'selected' : '' %>><%= p.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-secondary" style="padding:0.55rem 0.7rem;">Move</button>
    </form>
    <form class="inline-form" method="POST" action="/admin/rounds/<%= round.id %>/reassign-course"
      onsubmit="return confirm('Move this round to a different course?');" style="display:flex;gap:0.4rem;align-items:center;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <select name="courseId" required style="flex:1;min-width:0;">
        <% allCourses.forEach(c => { %>
          <option value="<%= c.id %>" <%= c.id === round.course_id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-secondary" style="padding:0.55rem 0.7rem;">Move</button>
    </form>
  </div>
</div>

<div class="card" style="max-width:640px;">
  <form method="POST" action="/admin/rounds/<%= round.id %>/edit"
    onsubmit="return confirm('Save this correction? It replaces <%= round.player_name %>\'s saved score for this round.');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="hole-list">
      <% holes.forEach(h => {
        const prev = holeScores.find(s => s.hole_number === h.hole_number);
      %>
        <div class="score-hole-row" data-par="<%= h.par %>" data-si="<%= h.stroke_index %>">
          <div class="hole-info">
            <div class="hole-num">Hole <%= h.hole_number %></div>
            <div class="hole-meta">Par <%= h.par %> · SI <%= h.stroke_index %></div>
          </div>
          <div class="stepper">
            <button type="button" class="minus" aria-label="Fewer strokes on hole <%= h.hole_number %>">&minus;</button>
            <input type="number" min="1" max="20" inputmode="numeric" name="hole_<%= h.hole_number %>" value="<%= prev ? prev.strokes : '' %>" required>
            <button type="button" class="plus" aria-label="More strokes on hole <%= h.hole_number %>">+</button>
          </div>
        </div>
      <% }) %>
    </div>
    <button type="submit">Save correction</button>
  </form>
</div>

<a class="sb-link" style="margin:0 20px;display:inline-block;" href="/competitions/<%= round.competition_id %>">&larr; Back to competition</a>

<script>
  document.querySelectorAll('.stepper').forEach((stepper) => {
    const input = stepper.querySelector('input');
    const par = parseInt(stepper.closest('.score-hole-row').dataset.par, 10);
    stepper.querySelector('.minus').addEventListener('click', () => {
      const cur = parseInt(input.value, 10);
      input.value = Number.isFinite(cur) ? Math.max(1, cur - 1) : par;
    });
    stepper.querySelector('.plus').addEventListener('click', () => {
      const cur = parseInt(input.value, 10);
      input.value = Number.isFinite(cur) ? Math.min(20, cur + 1) : par;
    });
  });
</script>

<%- include('../partials/footer') %>

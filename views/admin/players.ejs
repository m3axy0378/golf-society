<%- include('../partials/header', { title: 'Admin · Players', mainClass: 'scoreboard-view' }) %>

<nav class="admin-tabs">
  <a class="admin-tab active" href="/admin/players">Players</a>
  <a class="admin-tab" href="/admin/courses">Courses</a>
  <a class="admin-tab" href="/admin/competitions">Competitions</a>
  <a class="admin-tab" href="/admin/data">Data</a>
</nav>

<h1 style="margin:0.75rem 20px 0;">Players</h1>

<% if (error) { %><div class="error-box" style="margin:0.75rem 20px;"><%= error %></div><% } %>
<% if (message) { %><div class="success-box" style="margin:0.75rem 20px;"><%= message %></div><% } %>

<div class="card">
  <ul class="list-plain">
    <% players.forEach(p => { %>
      <li style="flex-direction:column;align-items:stretch;gap:0.6rem;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.5rem;">
          <div style="flex:1;min-width:260px;">
            <form class="inline-form" method="POST" action="/admin/players/<%= p.id %>/edit" style="display:flex;gap:0.4rem;flex-wrap:wrap;align-items:center;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="name" value="<%= p.name %>" required
                style="min-width:120px;flex:1;padding:0.25rem 0.4rem;border:1px solid var(--sb-border);border-radius:6px;font-weight:700;">
              <input type="email" name="email" value="<%= p.email %>" required
                style="min-width:180px;flex:1;padding:0.25rem 0.4rem;border:1px solid var(--sb-border);border-radius:6px;">
              <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;">Save</button>
            </form>
            <div style="margin-top:0.3rem;">
              <% if (p.is_admin) { %><span class="badge admin">Admin</span><% } %>
              <% if (p.is_test_user) { %><span class="badge test">Test user</span><% } %>
            </div>
          </div>
          <form class="inline-form" method="POST" action="/admin/players/<%= p.id %>/handicap" style="display:flex;align-items:center;gap:0.4rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="muted" style="font-size:0.8rem;" for="hcp-<%= p.id %>">Handicap Index</label>
            <input id="hcp-<%= p.id %>" type="number" step="0.1" name="handicapIndex" value="<%= p.handicap_index %>" style="width:70px;padding:0.25rem 0.4rem;border:1px solid var(--sb-border);border-radius:6px;">
            <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;">Save</button>
          </form>
        </div>
        <form class="inline-form" method="POST" action="/admin/players/<%= p.id %>/reset-password" style="display:flex;align-items:center;gap:0.4rem;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="muted" style="font-size:0.8rem;" for="pw-<%= p.id %>">New password</label>
          <input id="pw-<%= p.id %>" type="password" name="password" minlength="8" placeholder="At least 8 characters"
            style="width:170px;padding:0.25rem 0.4rem;border:1px solid var(--sb-border);border-radius:6px;">
          <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;">Set password</button>
        </form>
        <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
          <form class="inline-form" method="POST" action="/admin/players/<%= p.id %>/toggle-admin">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;"><%= p.is_admin ? 'Remove admin' : 'Make admin' %></button>
          </form>
          <form class="inline-form" method="POST" action="/admin/players/<%= p.id %>/toggle-test-user">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-secondary" style="padding:0.25rem 0.6rem;"><%= p.is_test_user ? 'Remove test user' : 'Make test user' %></button>
          </form>
          <form class="inline-form" method="POST" action="/admin/players/<%= p.id %>/delete" onsubmit="return confirm('Remove <%= p.name %> and all their scores?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-danger" style="padding:0.25rem 0.6rem;">Remove</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
  <p class="muted" style="font-size:0.8rem;margin:0.75rem 0 0;">
    Handicap Index doesn't move until a player has played <%= MIN_ROUNDS_FOR_AUTO_HANDICAP %> rounds — after that
    it's recalculated automatically after every one (best 4 of their last 8). Edits here hold until that point, so
    use it for a starting handicap or a one-off correction. This is also
    the fix if someone mistypes their handicap when they first confirm it — that confirmation locks the field on
    their own profile, but not here.
  </p>
</div>

<div class="card" style="max-width:480px;">
  <h2 class="mt-0">Add a player</h2>
  <form class="stacked" method="POST" action="/admin/players">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Name <input type="text" name="name" required></label>
    <label>Email <input type="email" name="email" required></label>
    <label>Starting Handicap Index <input type="number" step="0.1" name="handicapIndex" value="28.0" required></label>
    <label>Temporary password <input type="password" name="password" required></label>
    <label style="display:flex;align-items:center;gap:0.5rem;">
      <input type="checkbox" name="isAdmin" style="width:auto;margin:0;"> Make this player an admin too
    </label>
    <label style="display:flex;align-items:center;gap:0.5rem;">
      <input type="checkbox" name="isTestUser" style="width:auto;margin:0;"> Test user (for manual testing)
    </label>
    <button type="submit">Add player</button>
  </form>
  <p class="muted" style="font-size:0.85rem;">Share the email + temporary password with them so they can log in (they can't change their own password yet — ask them to keep it, or set a new one here any time).</p>
  <p class="muted" style="font-size:0.85rem;">
    A test user works exactly like any other player — enter competitions, submit scores, everything — but is left out
    of every leaderboard, the season standings and Order of Merit, and the handicaps list, so test rounds never show
    up to real players. Toggle it for an existing player from the list above at any time.
  </p>
</div>

<% if (players.length > 1) { %>
  <div class="card" style="max-width:480px;">
    <h2 class="mt-0">Merge duplicate players</h2>
    <p class="muted" style="font-size:0.85rem;margin-top:-0.5rem;">
      For two accounts that are the same person (a duplicate signup). Everything the second player has — rounds,
      entries, reactions, pairing spots — moves onto the first, then the second is deleted. This can't be undone.
    </p>
    <form class="stacked" method="POST" action="/admin/players/merge"
      onsubmit="return confirm('Merge these two players? This can\'t be undone.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Keep
        <select name="keepPlayerId" required>
          <% players.forEach(p => { %><option value="<%= p.id %>"><%= p.name %> (<%= p.email %>)</option><% }) %>
        </select>
      </label>
      <label>Merge in, then delete
        <select name="mergePlayerId" required>
          <% players.forEach(p => { %><option value="<%= p.id %>"><%= p.name %> (<%= p.email %>)</option><% }) %>
        </select>
      </label>
      <button type="submit" class="btn-danger">Merge</button>
    </form>
  </div>
<% } %>

<div class="card" style="max-width:480px;">
  <h2 class="mt-0">Society name</h2>
  <form class="stacked" method="POST" action="/admin/settings/society-name">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Name shown at the top of the app
      <input type="text" name="societyName" value="<%= societyName %>" required>
    </label>
    <button type="submit">Save</button>
  </form>
</div>

<div class="card" style="max-width:480px;">
  <h2 class="mt-0">Features</h2>
  <form method="POST" action="/admin/settings/pairing-sheet">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.85rem;">
      <input type="checkbox" name="enabled" style="width:auto;margin:0;" <%= pairingSheetEnabled ? 'checked' : '' %>>
      Pairing sheets
    </label>
    <button type="submit" class="btn-secondary">Save</button>
  </form>
  <p class="muted" style="font-size:0.85rem;margin-bottom:0;">
    Turns the tee-off pairing sheet builder on or off across the whole app. Switching it off hides "Pairing sheet"
    links and any saved tee-off order from competition pages — it doesn't delete anything already saved, so
    switching it back on brings existing sheets right back.
  </p>
</div>

<%- include('../partials/footer') %>

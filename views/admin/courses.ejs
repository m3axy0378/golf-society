<%- include('../partials/header', { title: 'Admin · Courses' }) %>

<div style="display:flex;gap:1rem;margin-bottom:0.75rem;font-size:0.9rem;">
  <a href="/admin/players" class="muted">Players</a>
  <a href="/admin/courses">Courses</a>
  <a href="/admin/competitions" class="muted">Competitions</a>
</div>

<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
  <h1 class="mt-0">Courses</h1>
  <a class="btn" href="/admin/courses/new">+ Add course</a>
</div>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<div class="card">
  <% if (courses.length === 0) { %>
    <p class="muted">No courses added yet.</p>
  <% } else { %>
    <ul class="list-plain">
      <% courses.forEach(c => { %>
        <li style="flex-direction:column;align-items:stretch;gap:0.6rem;">
          <div>
            <strong><%= c.name %></strong>
            <div class="muted" style="font-size:0.85rem;margin-top:0.15rem;">
              <%= c.tee_name %> tees · Par <%= c.par %> · CR <%= c.course_rating.toFixed(1) %> · SR <%= c.slope_rating %> · <%= c.holes_count %> holes
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.6rem;">
            <a class="btn btn-secondary" style="padding:0.25rem 0.6rem;" href="/admin/courses/<%= c.id %>/edit">Edit</a>
            <form class="inline-form" method="POST" action="/admin/courses/<%= c.id %>/delete"
              onsubmit="return confirm('Delete &quot;<%= c.name %>&quot;? This only works if it isn\'t linked to any competition.');">
              <button type="submit" class="btn-danger" style="padding:0.25rem 0.6rem;">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('../partials/footer') %>

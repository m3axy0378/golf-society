<%- include('../partials/header', { title: 'New competition' }) %>

<h1 class="mt-0">New competition</h1>
<% if (courseAdded) { %><div class="success-box">Course saved. Now set up the competition.</div><% } %>
<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<div class="card" style="max-width:520px;">
  <% if (courses.length === 0) { %>
    <p class="muted">You'll need to <a href="/admin/courses/new">add a course</a> first.</p>
  <% } else { %>
    <form class="stacked" method="POST" action="/admin/competitions">
      <label>Competition name <input type="text" name="name" placeholder="e.g. August Medal" required></label>
      <label>Date to be played by <input type="date" name="compDate" required></label>
      <div style="margin-bottom:1rem;">
        <div style="font-size:0.92rem;margin-bottom:0.3rem;">Course(s)</div>
        <p class="muted" style="font-size:0.82rem;margin:0 0 0.5rem;">
          Choose one, or several if different groups are playing different courses in this same competition.
        </p>
        <% courses.forEach(c => { %>
          <label style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
            <input type="checkbox" name="courseIds" value="<%= c.id %>" style="width:auto;margin:0;">
            <%= c.name %> (<%= c.tee_name %> tees, par <%= c.par %>)
          </label>
        <% }) %>
      </div>
      <label>Scoring format
        <select name="format" required>
          <option value="stableford">Stableford</option>
          <option value="net_stroke">Stroke play (net)</option>
          <option value="gross_stroke">Stroke play (gross)</option>
        </select>
      </label>
      <label>Competition type
        <select name="type" required>
          <option value="league">League — normal season points</option>
          <option value="major">Major — double season points</option>
          <option value="sprint">9 Hole Sprint — casual, doesn't count towards handicap or season</option>
        </select>
      </label>

      <label style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
        <input type="checkbox" name="entryFeeEnabled" id="entry-fee-toggle" style="width:auto;margin:0;">
        Charge an entry fee for this competition
      </label>
      <div id="entry-fee-fields" style="display:none;margin-bottom:1rem;">
        <div class="grid-2">
          <label>Amount (£) <input type="number" step="0.01" min="0.01" name="entryFeeAmount" placeholder="e.g. 5.00"></label>
          <label>Payment link <input type="url" name="entryFeeLink" placeholder="https://paypal.me/..."></label>
        </div>
        <p class="muted" style="font-size:0.82rem;margin:0;">
          Set this up yourself first (PayPal.me, a Stripe Payment Link, etc.) — the app just links players to it,
          it doesn't collect payment.
        </p>
      </div>

      <button type="submit">Create competition</button>
    </form>
  <% } %>
</div>

<script>
  const feeToggle = document.getElementById('entry-fee-toggle');
  if (feeToggle) {
    const feeFields = document.getElementById('entry-fee-fields');
    feeToggle.addEventListener('change', () => {
      feeFields.style.display = feeToggle.checked ? '' : 'none';
      feeFields.querySelectorAll('input').forEach((inp) => { inp.required = feeToggle.checked; });
    });
  }
</script>

<p><a class="muted" href="/admin/courses/new">+ Add another course</a></p>

<%- include('../partials/footer') %>

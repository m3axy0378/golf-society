<%- include('partials/header', { title: 'Reset password', mainClass: 'scoreboard-view' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <img class="brand-mark" src="/img/tee-league-icon-gold.svg" alt="" width="40" height="40">
    <h1>Reset password</h1>
    <% if (!valid) { %>
      <div class="error-box">This reset link is invalid or has expired.</div>
      <p class="auth-foot"><a class="sb-link" href="/forgot-password">Request a new link</a></p>
    <% } else { %>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form class="stacked" method="POST" action="/reset-password/<%= token %>">
        <label>New password
          <input type="password" name="password" minlength="8" required autofocus>
        </label>
        <button type="submit">Set new password</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

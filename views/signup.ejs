<%- include('partials/header', { title: 'Sign up', mainClass: 'scoreboard-view' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <img class="brand-mark" src="/img/tee-league-icon-gold.svg" alt="" width="40" height="40">
    <h1>Create your account</h1>
    <% if (error) { %><div class="error-box"><%= error %></div><% } %>
    <form class="stacked" method="POST" action="/signup">
      <label>Name
        <input type="text" name="name" value="<%= name %>" required autofocus>
      </label>
      <label>Email
        <input type="email" name="email" value="<%= email %>" required>
      </label>
      <label>Password
        <input type="password" name="password" required minlength="8">
      </label>
      <label>Confirm password
        <input type="password" name="confirmPassword" required minlength="8">
      </label>
      <button type="submit">Sign up</button>
    </form>
    <p class="auth-foot">Already have a login? <a class="sb-link" href="/login">Log in</a></p>
  </div>
</div>

<%- include('partials/footer', { hideTagline: true }) %>

<%- include('partials/header', { title: 'Set up your society', mainClass: 'scoreboard-view' }) %>

<div class="auth-wrap">
  <div class="auth-card" style="max-width:480px;">
    <img class="brand-mark" src="/img/tee-league-icon-gold.svg" alt="" width="44" height="44">
    <h1>Welcome</h1>
    <p class="muted" style="text-align:center;">Let's get your golf society's app set up. You'll be the first admin — you can add the rest of your friends afterwards.</p>

    <% if (error) { %><div class="error-box"><%= error %></div><% } %>

    <form class="stacked" method="POST" action="/setup">
      <label>Society name
        <input type="text" name="societyName" placeholder="e.g. The Fairway Chancers" required>
      </label>
      <label>Your name
        <input type="text" name="name" required>
      </label>
      <label>Your email
        <input type="email" name="email" required>
      </label>
      <label>Your current Handicap Index
        <input type="number" step="0.1" name="handicapIndex" placeholder="e.g. 18.4" required>
      </label>
      <label>Choose a password
        <input type="password" name="password" required>
      </label>
      <button type="submit">Create society &amp; continue</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'My profile' }) %>

<h1 class="mt-0">My profile</h1>

<div class="card" style="max-width:420px;">
  <p><strong><%= player.name %></strong><br><span class="muted"><%= player.email %></span></p>

  <% if (message) { %><div class="success-box"><%= message %></div><% } %>

  <% if (roundsPlayed === 0) { %>
    <form class="stacked" method="POST" action="/profile">
      <label>Starting Handicap Index
        <input type="number" step="0.1" name="handicapIndex" value="<%= player.handicap_index %>" required>
      </label>
      <button type="submit">Update</button>
    </form>
    <p class="muted" style="font-size:0.85rem;">
      This is used until your first submitted round — after that, your Handicap Index is calculated
      automatically from your scores (best 4 of your last 8 rounds), same as real-world handicapping.
    </p>
  <% } else { %>
    <p>Handicap Index <strong style="font-size:1.3rem;"><%= player.handicap_index %></strong></p>
    <p class="muted" style="font-size:0.85rem;">
      Calculated automatically from the best 4 of your last 8 rounds, and updates after every round you submit.
      See the <a href="/handicaps">Players Handicap</a> page for how it's worked out.
    </p>
  <% } %>
</div>

<%- include('partials/footer') %>

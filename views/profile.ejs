<%- include('partials/header', { title: 'Me', mainClass: 'scoreboard-view' }) %>

<div class="comp-header">
  <h1 class="comp-title" style="text-transform:none;font-size:1.75rem;"><%= player.name %></h1>
  <p class="comp-meta">
    <%= player.email %>
    <% if (currentPlayer.is_admin) { %> · <a class="sb-link" href="/admin/players">Admin</a><% } %>
  </p>
</div>

<% if (message) { %><div class="success-box" style="margin:0.75rem 20px;"><%= message %></div><% } %>

<div class="score-summary" style="position:static;margin:0.75rem 20px;">
  <div>
    <span class="sub">Rounds Played</span>
    <strong><%= roundsPlayed %></strong>
  </div>
  <div>
    <span class="sub">Avg Points</span>
    <strong><%= avgPoints === null ? '–' : avgPoints.toFixed(1) %></strong>
  </div>
  <div>
    <span class="sub">Handicap Index</span>
    <strong><%= player.handicap_index %></strong>
  </div>
</div>

<% if (roundsPlayed === 0) { %>
  <div class="card">
    <h2 class="mt-0" style="font-size:1.05rem;">Starting Handicap Index</h2>
    <form class="stacked" method="POST" action="/profile">
      <label>Starting Handicap Index
        <input type="number" step="0.1" name="handicapIndex" value="<%= player.handicap_index %>" required>
      </label>
      <button type="submit">Update</button>
    </form>
    <p class="muted" style="font-size:0.85rem;">
      This is used until your first submitted round — after that, your Handicap Index is calculated
      automatically from your scores (best 4 of your last 8 rounds), same as real-world handicapping.
    </p>
  </div>
<% } else { %>
  <p class="muted" style="font-size:0.85rem;margin:0 20px;">
    Calculated automatically from the best 4 of your last 8 rounds, and updates after every round you submit.
    See <a class="sb-link" href="/handicaps">Players Handicap</a> for how it's worked out.
  </p>
<% } %>

<div class="card">
  <h2 class="mt-0" style="font-size:1.05rem;">Handicap trend</h2>
  <% if (handicapTrend.length >= 2) {
    const vals = handicapTrend.map((p) => p.handicapIndex);
    const minV = Math.min(...vals);
    const maxV = Math.max(...vals);
    const range = maxV - minV || 1;
    const w = 600, h = 140, pad = 12;
    const stepX = handicapTrend.length > 1 ? (w - pad * 2) / (handicapTrend.length - 1) : 0;
    const points = handicapTrend.map((p, i) => {
      const x = pad + i * stepX;
      const y = pad + (h - pad * 2) * (1 - (p.handicapIndex - minV) / range);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    }).join(' ');
    const first = handicapTrend[0];
    const last = handicapTrend[handicapTrend.length - 1];
  %>
    <svg viewBox="0 0 <%= w %> <%= h %>" preserveAspectRatio="none" style="width:100%;height:140px;display:block;">
      <polyline points="<%= points %>" fill="none" stroke="var(--color-gold)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
    <div class="muted" style="display:flex;justify-content:space-between;font-size:0.8rem;margin-top:0.4rem;">
      <span><%= first.handicapIndex.toFixed(1) %> · <%= new Date(first.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
      <span><%= last.handicapIndex.toFixed(1) %> · Now</span>
    </div>
  <% } else { %>
    <p class="muted" style="margin-bottom:0;">Play a few more rounds to see your handicap trend over time.</p>
  <% } %>
</div>

<% if (bestRound || worstRound) { %>
  <div class="grid-2" style="margin:0 20px;width:calc(100% - 40px);">
    <% if (bestRound) { %>
      <div class="card" style="margin:0.75rem 0;">
        <h2 class="mt-0" style="font-size:1.05rem;">Best round</h2>
        <p class="muted" style="margin-top:-0.5rem;font-size:0.85rem;">
          <%= bestRound.comp_name %> · <%= bestRound.course_name %> ·
          <%= new Date(bestRound.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </p>
        <div class="leaderboard-stats">
          <div class="stat"><span class="stat-label">Gross</span><strong><%= bestRound.gross_total %></strong></div>
          <div class="stat"><span class="stat-label">Net</span><strong><%= bestRound.net_total %></strong></div>
          <div class="stat"><span class="stat-label">Points</span><strong style="color:var(--color-gold);"><%= bestRound.stableford_points %></strong></div>
        </div>
      </div>
    <% } %>
    <% if (worstRound && worstRound.id !== bestRound.id) { %>
      <div class="card" style="margin:0.75rem 0;">
        <h2 class="mt-0" style="font-size:1.05rem;">Toughest round</h2>
        <p class="muted" style="margin-top:-0.5rem;font-size:0.85rem;">
          <%= worstRound.comp_name %> · <%= worstRound.course_name %> ·
          <%= new Date(worstRound.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </p>
        <div class="leaderboard-stats">
          <div class="stat"><span class="stat-label">Gross</span><strong><%= worstRound.gross_total %></strong></div>
          <div class="stat"><span class="stat-label">Net</span><strong><%= worstRound.net_total %></strong></div>
          <div class="stat"><span class="stat-label">Points</span><strong><%= worstRound.stableford_points %></strong></div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<div class="card">
  <h2 class="mt-0" style="font-size:1.05rem;">Head-to-head</h2>
  <% if (headToHead.length === 0) { %>
    <p class="muted" style="margin-bottom:0;">No shared competitions with another player yet.</p>
  <% } else { %>
    <ul class="list-plain">
      <% headToHead.forEach(h => { %>
        <li>
          <span><%= h.playerName %></span>
          <span style="font-size:0.9rem;">
            <strong style="color:var(--sb-green-light);"><%= h.wins %>W</strong>
            &nbsp;–&nbsp;
            <strong style="color:var(--color-danger);"><%= h.losses %>L</strong>
            <% if (h.ties > 0) { %>&nbsp;–&nbsp;<strong class="muted"><%= h.ties %>T</strong><% } %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card">
  <h2 class="mt-0" style="font-size:1.05rem;">Round history</h2>
  <% if (myRounds.length === 0) { %>
    <p class="muted" style="margin-bottom:0;">You haven't submitted a round yet.</p>
  <% } else { %>
    <ul class="list-plain">
      <% myRounds.forEach(r => { %>
        <li style="flex-direction:column;align-items:stretch;gap:0.5rem;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;">
            <div>
              <strong><%= r.comp_name %></strong>
              <% if (r.comp_type !== 'league') { %><span class="badge"><%= TYPE_LABELS[r.comp_type] %></span><% } %>
              <div class="muted" style="font-size:0.8rem;margin-top:0.15rem;">
                <%= r.course_name %> · <%= new Date(r.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              </div>
            </div>
            <a class="sb-link" style="font-size:0.8rem;white-space:nowrap;" href="/rounds/<%= r.id %>/scorecard">Scorecard</a>
          </div>
          <div class="leaderboard-stats">
            <div class="stat"><span class="stat-label">Gross</span><strong><%= r.gross_total %></strong></div>
            <div class="stat"><span class="stat-label">Course Hcp</span><strong><%= r.course_handicap %></strong></div>
            <div class="stat"><span class="stat-label">Net</span><strong><%= r.net_total %></strong></div>
            <div class="stat"><span class="stat-label">Points</span><strong><%= r.stableford_points %></strong></div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<% if (vapidPublicKey) { %>
  <div class="card">
    <h2 class="mt-0" style="font-size:1.05rem;">Notifications</h2>
    <p class="muted" style="font-size:0.85rem;" id="push-status">Checking this device&hellip;</p>
    <button type="button" class="btn-secondary" id="push-toggle" style="display:none;"></button>
  </div>

  <script src="/push-client.js"></script>
  <script>
    (function () {
      const VAPID_PUBLIC_KEY = <%- JSON.stringify(vapidPublicKey) %>;
      const statusEl = document.getElementById('push-status');
      const toggleBtn = document.getElementById('push-toggle');

      if (!TeeLeaguePush.supported()) {
        statusEl.textContent = "This browser doesn't support push notifications.";
        return;
      }

      async function refreshUI() {
        const sub = await TeeLeaguePush.getSubscription();
        if (sub) {
          statusEl.textContent = 'Notifications are on for this device.';
          toggleBtn.textContent = 'Turn off';
        } else {
          statusEl.textContent = 'Get notified here when a new competition opens.';
          toggleBtn.textContent = 'Enable notifications';
        }
        toggleBtn.style.display = '';
      }

      toggleBtn.addEventListener('click', async () => {
        toggleBtn.disabled = true;
        const sub = await TeeLeaguePush.getSubscription();
        if (sub) {
          await TeeLeaguePush.unsubscribe();
        } else {
          const result = await TeeLeaguePush.subscribe(VAPID_PUBLIC_KEY);
          if (!result.ok && result.reason === 'denied') {
            statusEl.textContent = 'Notifications are blocked — allow them for this site in your browser settings to turn this on.';
            toggleBtn.disabled = false;
            return;
          }
        }
        await refreshUI();
        toggleBtn.disabled = false;
      });

      refreshUI().catch(() => {
        statusEl.textContent = "Couldn't set up notifications on this device.";
      });
    })();
  </script>
<% } %>

<div class="card">
  <form method="POST" action="/logout">
    <button type="submit" class="btn-secondary">Log out</button>
  </form>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Players Handicap', mainClass: 'scoreboard-view' }) %>

<div class="comp-header">
  <h1 class="comp-title" style="text-transform:none;font-size:1.75rem;">Players Handicap</h1>
  <p class="comp-meta">
    Each Handicap Index is the average of the best 4 Score Differentials from a player's last 8 rounds (real-world
    handicapping uses best 8 of last 20). With fewer than 8 rounds, roughly the best half count instead. A new
    player's Handicap Index starts as whatever was entered for them and switches to fully automatic from their
    first submitted round.
  </p>
</div>

<% if (handicaps.length === 0) { %>
  <div class="sb-empty">NO PLAYERS YET</div>
<% } else { %>
  <div class="hcp-list">
    <% handicaps.forEach(h => { %>
      <div class="hcp-row <%= h.player_id === currentPlayer.id ? 'hcp-row--me' : '' %>">
        <div>
          <div class="hcp-name"><%= h.player_name %></div>
          <div class="hcp-basis">
            <% if (h.roundsCounted === 0) { %>
              Starting handicap &mdash; no rounds submitted yet
            <% } else { %>
              Best <%= h.bestCount %> of last <%= h.roundsCounted %> round<%= h.roundsCounted === 1 ? '' : 's' %>
            <% } %>
          </div>
        </div>
        <% if (currentPlayer.is_admin) { %>
          <form class="inline-form hcp-edit-form" method="POST" action="/admin/players/<%= h.player_id %>/handicap">
            <input type="hidden" name="redirectTo" value="/handicaps">
            <% if (h.trend === 'down') { %><span class="hcp-trend hcp-trend--down" title="Improved since their last round">&darr;</span><% } %>
            <% if (h.trend === 'up') { %><span class="hcp-trend hcp-trend--up" title="Increased since their last round">&uarr;</span><% } %>
            <input type="number" step="0.1" name="handicapIndex" value="<%= h.handicap_index %>">
            <button type="submit" class="btn-secondary" style="padding:0.3rem 0.6rem;">Save</button>
          </form>
        <% } else { %>
          <div class="hcp-value-block">
            <% if (h.trend === 'down') { %><span class="hcp-trend hcp-trend--down" title="Improved since their last round">&darr;</span><% } %>
            <% if (h.trend === 'up') { %><span class="hcp-trend hcp-trend--up" title="Increased since their last round">&uarr;</span><% } %>
            <span class="hcp-value"><%= h.handicap_index %></span>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
  <% if (currentPlayer.is_admin) { %>
    <p class="muted" style="font-size:0.8rem;margin:0.75rem 20px 0;">
      Edits here only hold until the player's next round, since it's recalculated automatically after every one.
    </p>
  <% } %>
<% } %>

<%- include('partials/footer') %>

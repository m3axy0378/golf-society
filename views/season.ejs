<%- include('partials/header', { title: 'Season standings', mainClass: 'scoreboard-view' }) %>

<div class="comp-header">
  <h1 class="comp-title" style="text-transform:none;font-size:1.75rem;">Season standings</h1>
  <p class="comp-meta">
    An Order of Merit across all <%= competitionsCount %> competition<%= competitionsCount === 1 ? '' : 's' %> so far.
    Only the top 3 finishers in each score points — 5 for 1st, 3 for 2nd, 1 for 3rd — so results are comparable even
    when the course or format changes. Majors count double; 9 Hole Sprints don't count at all.
  </p>
</div>

<div class="lb-section" style="padding-top:0;">
  <% if (standings.length === 0) { %>
    <div class="sb-empty" style="padding-left:0;padding-right:0;">NO RESULTS YET</div>
  <% } else { %>
    <ul class="lb-list">
      <% standings.forEach((s, i) => { %>
        <li class="lb-row <%= i === 0 ? 'lb-row--leader' : '' %>">
          <div class="lb-main-row">
            <div class="lb-rank-diamond"><span><%= i + 1 %></span></div>
            <div class="lb-name-block">
              <div class="lb-name"><%= s.player_name %><%= s.player_id === currentPlayer.id ? ' (you)' : '' %></div>
            </div>
            <div class="leaderboard-stats" style="flex-wrap:nowrap;gap:1.25rem;">
              <div class="stat" style="width:3.6rem;text-align:right;"><span class="stat-label">HCP</span><strong><%= s.handicapIndex === null ? '–' : s.handicapIndex %></strong></div>
              <div class="stat" style="width:3.6rem;text-align:right;"><span class="stat-label">Played</span><strong><%= s.competitionsPlayed %></strong></div>
              <div class="stat" style="width:3.6rem;text-align:right;"><span class="stat-label">Points</span><strong<%= i === 0 ? ' style="color:var(--color-gold);"' : '' %>><%= s.totalPoints %></strong></div>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>

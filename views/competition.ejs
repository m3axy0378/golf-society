<%- include('partials/header', { title: comp.name }) %>

<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.75rem;">
  <div>
    <h1 class="mt-0"><%= comp.name %> <% if (comp.type !== 'league') { %><span class="badge"><%= TYPE_LABELS[comp.type] %></span><% } %></h1>
    <p class="muted" style="margin-top:-0.5rem;">
      <%= new Date(comp.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
      ·
      <% if (courses.length === 1) { %>
        <%= courses[0].name %> (<%= courses[0].tee_name %> tees, par <%= courses[0].par %>, CR <%= courses[0].course_rating.toFixed(1) %> / SR <%= courses[0].slope_rating %>)
      <% } else { %>
        <%= courses.map(c => c.name).join(', ') %>
      <% } %>
      · Format: <strong><%= FORMAT_LABELS[comp.format] %></strong>
      <% if (comp.type === 'sprint') { %> · <span class="muted">Casual — doesn't count towards handicap or season standings</span><% } %>
    </p>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem;">
    <span class="badge <%= comp.status === 'closed' ? 'closed' : '' %>"><%= comp.status === 'open' ? 'Open for entry' : 'Closed' %></span>
    <% if (currentPlayer.is_admin) { %>
      <form method="POST" action="/admin/competitions/<%= comp.id %>/notify" class="inline-form"
        onsubmit="return confirm('Send a push notification about &quot;<%= comp.name %>&quot; to every player who has notifications enabled?');">
        <button type="submit" class="btn-secondary">Notify players</button>
      </form>
      <a class="btn btn-secondary" target="_blank" rel="noopener"
        href="https://wa.me/?text=<%- encodeURIComponent(`🏌️ New competition: ${comp.name}\nCloses ${new Date(comp.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}\n${baseUrl}/competitions/${comp.id}`) %>">
        Share to WhatsApp
      </a>
      <form method="POST" action="/admin/competitions/<%= comp.id %>/toggle-status" class="inline-form">
        <button type="submit" class="btn-secondary"><%= comp.status === 'open' ? 'End competition' : 'Reopen' %></button>
      </form>
      <form method="POST" action="/admin/competitions/<%= comp.id %>/delete" class="inline-form"
        onsubmit="return confirm('Delete &quot;<%= comp.name %>&quot; and every score submitted for it? This can\'t be undone.');">
        <button type="submit" class="btn-danger">Delete</button>
      </form>
    <% } %>
  </div>
</div>

<% if (comp.entry_fee_enabled) { %>
  <% const feeAmount = parseFloat(comp.entry_fee_amount);
     const paidEntries = allEntries.filter(e => e.entry_fee_paid);
     const unpaidEntries = allEntries.filter(e => !e.entry_fee_paid);
     const pot = paidEntries.length * feeAmount;
  %>
  <div class="card" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
    <div>
      <p style="margin:0;">Entry fee: <strong>£<%= feeAmount.toFixed(2) %></strong></p>
      <p class="muted" style="margin:0.15rem 0 0;font-size:0.85rem;">
        Pot so far: <strong>£<%= pot.toFixed(2) %></strong> (<%= paidEntries.length %> paid<%= allEntries.length ? ` of ${allEntries.length}` : '' %>)
      </p>
    </div>
    <a class="btn" target="_blank" rel="noopener" href="<%= comp.entry_fee_link %>">Pay entry fee</a>
  </div>

  <% if (currentPlayer.is_admin) { %>
    <div class="card">
      <h2 class="mt-0" style="font-size:1.05rem;">Entry fee payments</h2>
      <% if (allEntries.length === 0) { %>
        <p class="muted" style="margin-bottom:0;">No entries yet.</p>
      <% } else { %>
        <ul class="list-plain">
          <% allEntries.forEach(e => { %>
            <li>
              <span><%= e.player_name %><% if (!e.round_id) { %> <span class="muted" style="font-size:0.8rem;">(not yet played)</span><% } %></span>
              <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.9rem;">
                <input type="checkbox" class="paid-toggle" data-entry-id="<%= e.id %>" <%= e.entry_fee_paid ? 'checked' : '' %>>
                Paid
              </label>
            </li>
          <% }) %>
        </ul>
        <% if (unpaidEntries.length > 0) { %>
          <a class="btn btn-secondary" target="_blank" rel="noopener" style="margin-top:0.5rem;"
            href="https://wa.me/?text=<%- encodeURIComponent(`💰 Entry fee reminder — ${comp.name} (£${feeAmount.toFixed(2)})\nStill to pay: ${unpaidEntries.map(e => e.player_name).join(', ')}\n${comp.entry_fee_link}`) %>">
            Message unpaid players on WhatsApp
          </a>
        <% } else { %>
          <p class="muted" style="margin:0.5rem 0 0;">Everyone's paid 🎉</p>
        <% } %>
      <% } %>
    </div>

    <script>
      // Reloads after saving rather than patching the DOM in place, so the
      // pot total, paid count and unpaid WhatsApp list (computed server-side
      // above) all stay in sync instead of drifting from what's checked here.
      document.querySelectorAll('.paid-toggle').forEach((box) => {
        box.addEventListener('change', async () => {
          box.disabled = true;
          await fetch(`/admin/entries/${box.dataset.entryId}/toggle-paid`, { method: 'POST' });
          window.location.reload();
        });
      });
    </script>
  <% } %>
<% } %>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<% if (comp.status === 'open' && myRound) { %>
  <div class="card">
    <h2 class="mt-0">Your round is saved</h2>
    <p class="muted" style="margin-top:-0.5rem;font-size:0.88rem;">
      <% const myCourse = courses.find(c => c.id === myRound.course_id); %>
      <% if (myCourse) { %>Played at <strong><%= myCourse.name %></strong>. <% } %>
      <% if (myRound.marker_name) { %>Marked by <strong><%= myRound.marker_name %></strong>. <% } %>
      Scores can't be changed once saved — ask an admin if this one needs correcting.
    </p>
    <div class="score-summary" style="position:static;">
      <div>
        <span class="sub">Gross</span>
        <strong><%= myRound.gross_total %></strong>
      </div>
      <div>
        <span class="sub">Net</span>
        <strong><%= myRound.net_total %></strong>
      </div>
      <div>
        <span class="sub">Stableford</span>
        <strong><%= myRound.stableford_points %></strong>
      </div>
    </div>
  </div>
<% } else if (comp.status === 'open' && !hasEntered) { %>
  <div class="card">
    <h2 class="mt-0">Ready to play?</h2>
    <p class="muted" style="margin-top:-0.5rem;font-size:0.88rem;">
      Enter this competition to appear on the leaderboard<% if (comp.entry_fee_enabled) { %> and let the admin know you're in for the entry fee<% } %> —
      you can submit your score any time before it closes.
    </p>
    <form method="POST" action="/competitions/<%= comp.id %>/enter">
      <button type="submit">Enter competition</button>
    </form>
  </div>
<% } else if (comp.status === 'open') { %>
  <div class="card">
    <h2 class="mt-0">Enter your round</h2>
    <p class="muted" style="margin-top:-0.5rem;font-size:0.88rem;">
      Your Handicap Index right now is <strong><%= currentPlayer.handicap_index %></strong>
      (update it on <a href="/profile">your profile</a> if it's changed).
      Your Course Handicap for this round will be calculated automatically.
      Once you save, it's final — double check your scores first, as only an admin can change them after that.
    </p>

    <% if (courses.length + otherCourses.length > 0) { %>
      <form method="GET" action="/competitions/<%= comp.id %>" style="margin-bottom:1rem;">
        <label style="display:block;font-size:0.9rem;">
          <span style="display:block;margin-bottom:0.3rem;">Which course did you play?</span>
          <select name="course" onchange="this.form.submit()"
            style="display:block;width:100%;padding:0.55rem 0.7rem;border:1px solid var(--border);border-radius:8px;font-size:1rem;background:var(--color-white);color:var(--text);">
            <option value="">— Choose a course —</option>
            <% if (courses.length > 0) { %>
              <optgroup label="This competition">
                <% courses.forEach(c => { %>
                  <option value="<%= c.id %>" <%= selectedCourse && selectedCourse.id === c.id ? 'selected' : '' %>>
                    <%= c.name %> (<%= c.tee_name %> tees, par <%= c.par %>)
                  </option>
                <% }) %>
              </optgroup>
            <% } %>
            <% if (otherCourses.length > 0) { %>
              <optgroup label="Other saved courses">
                <% otherCourses.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %> (<%= c.tee_name %> tees, par <%= c.par %>)</option>
                <% }) %>
              </optgroup>
            <% } %>
          </select>
        </label>
      </form>
    <% } %>

    <p style="margin-bottom:1rem;">
      <a class="btn-secondary" href="/competitions/<%= comp.id %>/add-course">+ Add my course</a>
      <span class="muted" style="font-size:0.85rem;">Can't find your course above? Search for it here.</span>
    </p>

    <% if (selectedCourse) { %>
      <div class="score-summary">
        <div>
          <span class="sub">Holes</span>
          <strong id="summary-holes">0/<%= holes.length %></strong>
        </div>
        <div>
          <span class="sub">Gross</span>
          <strong id="summary-gross-top">–</strong>
        </div>
        <div>
          <span class="sub">Stableford</span>
          <strong id="summary-points-top">–</strong>
        </div>
      </div>

      <form method="POST" action="/competitions/<%= comp.id %>/score" id="score-form"
        onsubmit="return confirm('Save this round? Once saved you won\'t be able to change it yourself — only an admin can fix a mistake after this.');">
        <input type="hidden" name="courseId" value="<%= selectedCourse.id %>">

        <% if (markers.length > 0) { %>
          <label style="display:block;font-size:0.9rem;margin-bottom:1rem;">
            <span style="display:block;margin-bottom:0.3rem;">Who marked your card?</span>
            <select name="markerId" required
              style="display:block;width:100%;padding:0.55rem 0.7rem;border:1px solid var(--border);border-radius:8px;font-size:1rem;background:var(--color-white);color:var(--text);">
              <option value="">— Choose a member —</option>
              <% markers.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.name %></option>
              <% }) %>
            </select>
          </label>
        <% } %>

        <div class="hole-list">
          <% holes.forEach(h => {
            const prev = myHoleScores.find(s => s.hole_number === h.hole_number);
          %>
            <div class="score-hole-row" data-par="<%= h.par %>" data-si="<%= h.stroke_index %>">
              <div class="hole-info">
                <div class="hole-num">Hole <%= h.hole_number %></div>
                <div class="hole-meta">Par <%= h.par %> · SI <%= h.stroke_index %></div>
              </div>
              <div class="stepper">
                <button type="button" class="minus" aria-label="Fewer strokes on hole <%= h.hole_number %>">&minus;</button>
                <input type="number" min="1" max="20" inputmode="numeric" name="hole_<%= h.hole_number %>" value="<%= prev ? prev.strokes : '' %>" required>
                <button type="button" class="plus" aria-label="More strokes on hole <%= h.hole_number %>">+</button>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="score-summary" style="position:static;">
          <div>
            <span class="sub">Gross</span>
            <strong id="summary-gross-bottom">–</strong>
          </div>
          <div>
            <span class="sub">Net</span>
            <strong id="summary-net-bottom">–</strong>
          </div>
          <div>
            <span class="sub">Stableford</span>
            <strong id="summary-points-bottom">–</strong>
          </div>
        </div>

        <button type="submit">Save round</button>
      </form>
    <% } else { %>
      <p class="muted">Choose which course you played above to enter your scores.</p>
    <% } %>
  </div>
<% } else if (myRound) { %>
  <div class="card">
    <h2 class="mt-0">Your round</h2>
    <p>Gross <strong><%= myRound.gross_total %></strong> · Net <strong><%= myRound.net_total %></strong> · Stableford <strong><%= myRound.stableford_points %></strong> pts (Course Hcp <%= myRound.course_handicap %>)</p>
  </div>
<% } %>

<div class="card">
  <h2 class="mt-0">Leaderboard</h2>
  <p class="muted" style="margin-top:-0.5rem;font-size:0.85rem;">
    Only the top 3 earn Order of Merit points for the season standings — 5 for 1st, 3 for 2nd, 1 for 3rd. Ties are
    split by a back-9 countback (then back 6, back 3, last hole).
  </p>
  <% if (ranked.length === 0 && pendingEntries.length === 0) { %>
    <p class="muted">No entries yet.</p>
  <% } else { %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Rank</th>
            <th>Player</th>
            <% if (courses.length > 1) { %><th>Course</th><% } %>
            <th class="num">Gross</th>
            <th class="num">Course Hcp</th>
            <th class="num">Net</th>
            <th class="num">Points</th>
            <th>React</th>
            <% if (currentPlayer.is_admin) { %><th></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% ranked.forEach(r => { %>
            <tr class="<%= r.player_id === currentPlayer.id ? 'me' : '' %> <%= r.rank === 1 ? 'rank-1' : '' %>">
              <td><%= r.rank %></td>
              <td>
                <%= r.player_name %>
                <% if (comp.entry_fee_enabled) {
                  const entry = allEntries.find(e => e.player_id === r.player_id);
                %>
                  <% if (entry && entry.entry_fee_paid) { %><span title="Entry fee paid">💷</span><% } %>
                <% } %>
              </td>
              <% if (courses.length > 1) { %><td class="muted" style="font-size:0.85rem;"><%= r.course_name %></td><% } %>
              <td class="num" style="<%= comp.format === 'gross_stroke' ? 'font-weight:700' : '' %>"><%= r.gross_total %></td>
              <td class="num"><%= r.course_handicap %></td>
              <td class="num" style="<%= comp.format === 'net_stroke' ? 'font-weight:700' : '' %>"><%= r.net_total %></td>
              <td class="num" style="<%= comp.format === 'stableford' ? 'font-weight:700' : '' %>"><%= r.stableford_points %></td>
              <td>
                <div class="reaction-row" data-round-id="<%= r.id %>">
                  <% REACTION_EMOJIS.forEach(emoji => {
                    const info = (reactionsByRound[r.id] && reactionsByRound[r.id][emoji]) || { count: 0, reactedByMe: false };
                  %>
                    <button type="button" class="reaction-btn<%= info.reactedByMe ? ' reacted' : '' %>" data-emoji="<%= emoji %>">
                      <%= emoji %><% if (info.count > 0) { %><span class="reaction-count"><%= info.count %></span><% } %>
                    </button>
                  <% }) %>
                </div>
              </td>
              <% if (currentPlayer.is_admin) { %>
                <td style="text-align:right;"><a class="muted" style="font-size:0.8rem;" href="/admin/rounds/<%= r.id %>/edit">Edit</a></td>
              <% } %>
            </tr>
          <% }) %>
          <% pendingEntries.forEach(e => { %>
            <tr class="<%= e.player_id === currentPlayer.id ? 'me' : '' %>">
              <td>–</td>
              <td>
                <%= e.player_name %>
                <% if (comp.entry_fee_enabled && e.entry_fee_paid) { %><span title="Entry fee paid">💷</span><% } %>
                <span class="muted" style="font-size:0.8rem;">(entered, not yet played)</span>
              </td>
              <% if (courses.length > 1) { %><td class="muted">–</td><% } %>
              <td class="num">0</td>
              <td class="num">–</td>
              <td class="num">0</td>
              <td class="num">0</td>
              <td></td>
              <% if (currentPlayer.is_admin) { %><td></td><% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
  document.querySelectorAll('.reaction-row').forEach((row) => {
    row.addEventListener('click', async (e) => {
      const btn = e.target.closest('.reaction-btn');
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/rounds/${row.dataset.roundId}/react`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emoji: btn.dataset.emoji }),
        });
        const data = await res.json();
        if (!res.ok) return;
        btn.classList.toggle('reacted', data.reactedByMe);
        const countEl = btn.querySelector('.reaction-count');
        if (data.count > 0) {
          if (countEl) {
            countEl.textContent = data.count;
          } else {
            const span = document.createElement('span');
            span.className = 'reaction-count';
            span.textContent = data.count;
            btn.appendChild(span);
          }
        } else if (countEl) {
          countEl.remove();
        }
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<a class="muted" href="/dashboard">&larr; Back to all competitions</a>

<% if (comp.status === 'open' && hasEntered && !myRound && selectedCourse) { %>
  <script>
    // Live in-page preview only — mirrors the pure-math parts of
    // lib/scoring.js so the running total updates instantly as you tap.
    // The server always recomputes the real result from scratch on save,
    // so a mismatch here can only ever mislead the preview, never the score.
    (function () {
      const handicapIndex = <%= currentPlayer.handicap_index %>;
      const slopeRating = <%= selectedCourse.slope_rating %>;
      const courseRating = <%= selectedCourse.course_rating %>;
      const coursePar = <%= selectedCourse.par %>;
      const holesPlayed = <%= holes.length %>;
      const courseHcp = Math.round(handicapIndex * (slopeRating / 113) + (courseRating - coursePar));

      function strokesReceived(strokeIndex) {
        if (courseHcp >= 0) {
          const base = Math.floor(courseHcp / holesPlayed);
          const extra = (courseHcp % holesPlayed) >= strokeIndex ? 1 : 0;
          return base + extra;
        }
        const posHcp = Math.abs(courseHcp);
        const base = -Math.floor(posHcp / holesPlayed);
        const reverseIndex = holesPlayed - strokeIndex + 1;
        const extra = (posHcp % holesPlayed) >= reverseIndex ? -1 : 0;
        return base + extra;
      }

      function stablefordPoints(strokes, par, received) {
        return Math.max(0, 2 - (strokes - received - par));
      }

      const rows = Array.from(document.querySelectorAll(".score-hole-row"));

      function updateSummary() {
        let holesDone = 0;
        let gross = 0;
        let points = 0;
        rows.forEach((row) => {
          const input = row.querySelector('input[type="number"]');
          const val = parseInt(input.value, 10);
          if (Number.isFinite(val) && val > 0) {
            holesDone += 1;
            gross += val;
            const par = parseInt(row.dataset.par, 10);
            const si = parseInt(row.dataset.si, 10);
            points += stablefordPoints(val, par, strokesReceived(si));
            row.classList.add('done');
          } else {
            row.classList.remove('done');
          }
        });
        const net = gross - courseHcp;
        document.getElementById('summary-holes').textContent = holesDone + '/' + holesPlayed;
        document.getElementById('summary-gross-top').textContent = holesDone ? gross : '–';
        document.getElementById('summary-points-top').textContent = holesDone ? points : '–';
        document.getElementById('summary-gross-bottom').textContent = holesDone ? gross : '–';
        document.getElementById('summary-net-bottom').textContent = holesDone ? net : '–';
        document.getElementById('summary-points-bottom').textContent = holesDone ? points : '–';
      }

      document.querySelectorAll('.stepper').forEach((stepper) => {
        const input = stepper.querySelector('input');
        const par = parseInt(stepper.closest('.score-hole-row').dataset.par, 10);
        stepper.querySelector('.minus').addEventListener('click', () => {
          const cur = parseInt(input.value, 10);
          input.value = Number.isFinite(cur) ? Math.max(1, cur - 1) : par;
          updateSummary();
        });
        stepper.querySelector('.plus').addEventListener('click', () => {
          const cur = parseInt(input.value, 10);
          input.value = Number.isFinite(cur) ? Math.min(20, cur + 1) : par;
          updateSummary();
        });
        input.addEventListener('input', updateSummary);
      });

      updateSummary();
    })();
  </script>
<% } %>

<%- include('partials/footer') %>

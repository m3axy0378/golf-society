<%- include('partials/header', { title: comp.name }) %>

<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:0.75rem;">
  <div>
    <h1 class="mt-0"><%= comp.name %></h1>
    <p class="muted" style="margin-top:-0.5rem;">
      <%= new Date(comp.comp_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
      ·
      <% if (courses.length === 1) { %>
        <%= courses[0].name %> (<%= courses[0].tee_name %> tees, par <%= courses[0].par %>, CR <%= courses[0].course_rating.toFixed(1) %> / SR <%= courses[0].slope_rating %>)
      <% } else { %>
        <%= courses.map(c => c.name).join(', ') %>
      <% } %>
      · Format: <strong><%= FORMAT_LABELS[comp.format] %></strong>
    </p>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem;">
    <span class="badge <%= comp.status === 'closed' ? 'closed' : '' %>"><%= comp.status === 'open' ? 'Open for entry' : 'Closed' %></span>
    <% if (currentPlayer.is_admin) { %>
      <form method="POST" action="/admin/competitions/<%= comp.id %>/toggle-status" class="inline-form">
        <button type="submit" class="btn-secondary"><%= comp.status === 'open' ? 'Close competition' : 'Reopen' %></button>
      </form>
    <% } %>
  </div>
</div>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<% if (comp.status === 'open') { %>
  <div class="card">
    <h2 class="mt-0"><%= myRound ? 'Update your round' : 'Enter your round' %></h2>
    <p class="muted" style="margin-top:-0.5rem;font-size:0.88rem;">
      Your Handicap Index right now is <strong><%= currentPlayer.handicap_index %></strong>
      (update it on <a href="/profile">your profile</a> if it's changed).
      Your Course Handicap for this round will be calculated automatically.
    </p>

    <p style="margin-bottom:1rem;">
      <a class="btn-secondary" href="/competitions/<%= comp.id %>/add-course">+ Add my course</a>
      <span class="muted" style="font-size:0.85rem;">Playing somewhere not listed below? Add it here.</span>
    </p>

    <% if (courses.length > 1) { %>
      <form method="GET" action="/competitions/<%= comp.id %>" style="margin-bottom:1rem;">
        <label style="display:block;font-size:0.9rem;">
          <span style="display:block;margin-bottom:0.3rem;">Which course did you play?</span>
          <select name="course" onchange="this.form.submit()"
            style="display:block;width:100%;padding:0.55rem 0.7rem;border:1px solid var(--border);border-radius:8px;font-size:1rem;background:var(--color-white);color:var(--text);">
            <option value="">— Choose a course —</option>
            <% courses.forEach(c => { %>
              <option value="<%= c.id %>" <%= selectedCourse && selectedCourse.id === c.id ? 'selected' : '' %>>
                <%= c.name %> (<%= c.tee_name %> tees, par <%= c.par %>)
              </option>
            <% }) %>
          </select>
        </label>
      </form>
    <% } %>

    <% if (selectedCourse) { %>
      <div class="score-summary">
        <div>
          <span class="sub">Holes</span>
          <strong id="summary-holes">0/<%= holes.length %></strong>
        </div>
        <div>
          <span class="sub">Gross</span>
          <strong id="summary-gross">–</strong>
        </div>
        <div>
          <span class="sub">Stableford</span>
          <strong id="summary-points">–</strong>
        </div>
      </div>

      <form method="POST" action="/competitions/<%= comp.id %>/score" id="score-form">
        <input type="hidden" name="courseId" value="<%= selectedCourse.id %>">
        <div class="hole-list">
          <% holes.forEach(h => {
            const prev = myHoleScores.find(s => s.hole_number === h.hole_number);
          %>
            <div class="score-hole-row" data-par="<%= h.par %>" data-si="<%= h.stroke_index %>">
              <div class="hole-info">
                <div class="hole-num">Hole <%= h.hole_number %></div>
                <div class="hole-meta">Par <%= h.par %> · SI <%= h.stroke_index %></div>
              </div>
              <div class="stepper">
                <button type="button" class="minus" aria-label="Fewer strokes on hole <%= h.hole_number %>">&minus;</button>
                <input type="number" min="1" max="20" inputmode="numeric" name="hole_<%= h.hole_number %>" value="<%= prev ? prev.strokes : '' %>" required>
                <button type="button" class="plus" aria-label="More strokes on hole <%= h.hole_number %>">+</button>
              </div>
            </div>
          <% }) %>
        </div>
        <button type="submit"><%= myRound ? 'Update round' : 'Save round' %></button>
      </form>
    <% } else { %>
      <p class="muted">Choose which course you played above to enter your scores.</p>
    <% } %>
  </div>
<% } else if (myRound) { %>
  <div class="card">
    <h2 class="mt-0">Your round</h2>
    <p>Gross <strong><%= myRound.gross_total %></strong> · Net <strong><%= myRound.net_total %></strong> · Stableford <strong><%= myRound.stableford_points %></strong> pts (Course Hcp <%= myRound.course_handicap %>)</p>
  </div>
<% } %>

<div class="card">
  <h2 class="mt-0">Leaderboard</h2>
  <% if (ranked.length === 0) { %>
    <p class="muted">No scores entered yet.</p>
  <% } else { %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Rank</th>
            <th>Player</th>
            <% if (courses.length > 1) { %><th>Course</th><% } %>
            <th class="num">Gross</th>
            <th class="num">Course Hcp</th>
            <th class="num">Net</th>
            <th class="num">Points</th>
          </tr>
        </thead>
        <tbody>
          <% ranked.forEach(r => { %>
            <tr class="<%= r.player_id === currentPlayer.id ? 'me' : '' %> <%= r.rank === 1 ? 'rank-1' : '' %>">
              <td><%= r.rank %></td>
              <td><%= r.player_name %></td>
              <% if (courses.length > 1) { %><td class="muted" style="font-size:0.85rem;"><%= r.course_name %></td><% } %>
              <td class="num" style="<%= comp.format === 'gross_stroke' ? 'font-weight:700' : '' %>"><%= r.gross_total %></td>
              <td class="num"><%= r.course_handicap %></td>
              <td class="num" style="<%= comp.format === 'net_stroke' ? 'font-weight:700' : '' %>"><%= r.net_total %></td>
              <td class="num" style="<%= comp.format === 'stableford' ? 'font-weight:700' : '' %>"><%= r.stableford_points %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<a class="muted" href="/dashboard">&larr; Back to all competitions</a>

<% if (comp.status === 'open' && selectedCourse) { %>
  <script>
    // Live in-page preview only — mirrors the pure-math parts of
    // lib/scoring.js so the running total updates instantly as you tap.
    // The server always recomputes the real result from scratch on save,
    // so a mismatch here can only ever mislead the preview, never the score.
    (function () {
      const handicapIndex = <%= currentPlayer.handicap_index %>;
      const slopeRating = <%= selectedCourse.slope_rating %>;
      const courseRating = <%= selectedCourse.course_rating %>;
      const coursePar = <%= selectedCourse.par %>;
      const holesPlayed = <%= holes.length %>;
      const courseHcp = Math.round(handicapIndex * (slopeRating / 113) + (courseRating - coursePar));

      function strokesReceived(strokeIndex) {
        if (courseHcp >= 0) {
          const base = Math.floor(courseHcp / holesPlayed);
          const extra = (courseHcp % holesPlayed) >= strokeIndex ? 1 : 0;
          return base + extra;
        }
        const posHcp = Math.abs(courseHcp);
        const base = -Math.floor(posHcp / holesPlayed);
        const reverseIndex = holesPlayed - strokeIndex + 1;
        const extra = (posHcp % holesPlayed) >= reverseIndex ? -1 : 0;
        return base + extra;
      }

      function stablefordPoints(strokes, par, received) {
        return Math.max(0, 2 - (strokes - received - par));
      }

      const rows = Array.from(document.querySelectorAll(".score-hole-row"));

      function updateSummary() {
        let holesDone = 0;
        let gross = 0;
        let points = 0;
        rows.forEach((row) => {
          const input = row.querySelector('input[type="number"]');
          const val = parseInt(input.value, 10);
          if (Number.isFinite(val) && val > 0) {
            holesDone += 1;
            gross += val;
            const par = parseInt(row.dataset.par, 10);
            const si = parseInt(row.dataset.si, 10);
            points += stablefordPoints(val, par, strokesReceived(si));
            row.classList.add('done');
          } else {
            row.classList.remove('done');
          }
        });
        document.getElementById('summary-holes').textContent = holesDone + '/' + holesPlayed;
        document.getElementById('summary-gross').textContent = holesDone ? gross : '–';
        document.getElementById('summary-points').textContent = holesDone ? points : '–';
      }

      document.querySelectorAll('.stepper').forEach((stepper) => {
        const input = stepper.querySelector('input');
        stepper.querySelector('.minus').addEventListener('click', () => {
          const cur = parseInt(input.value, 10);
          input.value = Number.isFinite(cur) ? Math.max(1, cur - 1) : 3;
          updateSummary();
        });
        stepper.querySelector('.plus').addEventListener('click', () => {
          const cur = parseInt(input.value, 10);
          input.value = Number.isFinite(cur) ? Math.min(20, cur + 1) : 4;
          updateSummary();
        });
        input.addEventListener('input', updateSummary);
      });

      updateSummary();
    })();
  </script>
<% } %>

<%- include('partials/footer') %>

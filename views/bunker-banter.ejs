<%- include('partials/header', { title: 'The Bunker Banter' }) %>

<h1 class="mt-0">The Bunker Banter 🏖️</h1>
<p class="muted" style="margin-top:-0.75rem;">One chat room for the whole society — banter, chirp your mates, drop your best (or worst) scores.</p>

<div class="card chat-card">
  <div class="chat-log" id="chat-log"></div>

  <div class="chat-emoji-row" id="chat-emoji-row">
    <% ['⛳','🏌️','🔥','😂','👏','🤦','😭','💪','🍺','🏆'].forEach(e => { %>
      <button type="button" class="chat-emoji-btn"><%= e %></button>
    <% }) %>
  </div>

  <form id="chat-form" class="chat-input-row">
    <textarea id="chat-input" maxlength="500" rows="1" placeholder="Say something..." required></textarea>
    <button type="submit" class="btn">Send</button>
  </form>
  <p class="error-box" id="chat-error" style="display:none;"></p>
</div>

<script>
  (function () {
    // Escaping "<" stops a message body containing "</script>" from closing
    // this tag early and injecting markup — messages are free-text from players.
    const INITIAL_MESSAGES = <%- JSON.stringify(messages).replace(/</g, '\\u003c') %>;
    const CURRENT_PLAYER_ID = <%- JSON.stringify(currentPlayer.id) %>;
    const CAN_MODERATE = <%- JSON.stringify(!!currentPlayer.is_admin) %>;

    const log = document.getElementById('chat-log');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const errorEl = document.getElementById('chat-error');
    const emojiRow = document.getElementById('chat-emoji-row');

    let lastId = 0;

    function isNearBottom() {
      return log.scrollHeight - log.scrollTop - log.clientHeight < 80;
    }

    function formatTime(iso) {
      return new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    }

    function renderMessage(m) {
      const row = document.createElement('div');
      row.className = 'chat-msg' + (m.playerId === CURRENT_PLAYER_ID ? ' me' : '');
      row.dataset.id = m.id;

      const meta = document.createElement('div');
      meta.className = 'chat-meta';
      meta.textContent = `${m.playerName} · ${formatTime(m.createdAt)}`;
      row.appendChild(meta);

      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble';
      bubble.textContent = m.body; // textContent — never innerHTML — so nothing in a message can execute as markup.
      row.appendChild(bubble);

      if (m.playerId === CURRENT_PLAYER_ID || CAN_MODERATE) {
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'chat-delete';
        del.textContent = 'Delete';
        del.addEventListener('click', async () => {
          row.remove();
          await fetch(`/bunker-banter/${m.id}/delete`, { method: 'POST' });
        });
        row.appendChild(del);
      }

      return row;
    }

    function appendMessage(m) {
      const stick = isNearBottom();
      log.appendChild(renderMessage(m));
      if (stick) log.scrollTop = log.scrollHeight;
    }

    if (INITIAL_MESSAGES.length === 0) {
      const p = document.createElement('p');
      p.className = 'muted';
      p.textContent = 'No messages yet — say something.';
      log.appendChild(p);
    } else {
      INITIAL_MESSAGES.forEach((m) => {
        log.appendChild(renderMessage(m));
        lastId = m.id;
      });
    }
    log.scrollTop = log.scrollHeight;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = input.value.trim();
      if (!body) return;
      errorEl.style.display = 'none';

      const emptyMsg = log.querySelector('p.muted');
      const submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      try {
        const res = await fetch('/bunker-banter/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body }),
        });
        const data = await res.json();
        if (!res.ok) {
          errorEl.textContent = data.error || 'Could not send that message.';
          errorEl.style.display = '';
          return;
        }
        if (emptyMsg) emptyMsg.remove();
        input.value = '';
        input.style.height = 'auto';
        lastId = data.message.id;
        appendMessage(data.message);
      } finally {
        submitBtn.disabled = false;
        input.focus();
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    });

    emojiRow.addEventListener('click', (e) => {
      if (!e.target.classList.contains('chat-emoji-btn')) return;
      input.value += e.target.textContent;
      input.dispatchEvent(new Event('input'));
      input.focus();
    });

    async function poll() {
      try {
        const res = await fetch(`/bunker-banter/messages?afterId=${lastId}`);
        const data = await res.json();
        if (data.messages.length === 0) return;
        const emptyMsg = log.querySelector('p.muted');
        if (emptyMsg) emptyMsg.remove();
        for (const m of data.messages) {
          lastId = m.id;
          appendMessage(m);
        }
      } catch (e) {
        // Quietly retry next tick — a missed poll isn't worth surfacing.
      }
    }

    setInterval(poll, 6000);
  })();
</script>

<%- include('partials/footer') %>
